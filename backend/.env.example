# ---------------------------------------------------------------------------------------------
# NESTR. backend — copy to backend/.env (or run `npm run setup:env`, which fills random secrets).
# Never commit backend/.env. Only this example file is tracked.
# ---------------------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (the Vite dev server)
CORS_ORIGIN=http://localhost:5173
# Used to build property links in AI replies and the admin link in broker emails
PUBLIC_SITE_URL=http://localhost:5173

# --- Database -------------------------------------------------------------------------------
# MongoDB Atlas connection string (Atlas → Connect → Drivers). For local dev without Atlas use
#   mongodb://127.0.0.1:27017   (and run `docker compose --profile local-mongo up -d`)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name used by this app (overrides any db name inside the URI)
MONGODB_DB=nestr_leads

# --- LLM providers (Groq primary, Gemini automatic fallback) ---------------------------------
# Pick current production models via each provider's list-models endpoint (see docs/RUNBOOK.md)
GROQ_API_KEY=<your-groq-key>
GROQ_MODEL=openai/gpt-oss-120b
# Separate Groq model for reply drafting (own tokens-per-minute bucket on the free tier)
GROQ_REPLY_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GEMINI_API_KEY=<your-gemini-key>
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=20000

# --- n8n ----------------------------------------------------------------------------------------
# Production webhook of the "Lead Intake & Qualification" workflow
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-intake
N8N_HEALTH_URL=http://localhost:5678/healthz
N8N_TIMEOUT_MS=45000
# Set to false to force the in-process fallback pipeline
N8N_ENABLED=true
# Shared secret: n8n → backend internal API (X-Internal-Secret) and backend → n8n webhook header auth.
# Must match the "Backend Internal Secret" credential in n8n (import.sh sets it). 48+ random chars.
INTERNAL_API_SECRET=<random-48-chars>

# --- Google Sheets / Apps Script web app ------------------------------------------------------
# Deployed Apps Script web app URL (…/exec) and the token stored in its Script Properties
SHEETS_WEBAPP_URL=
# Optional: the spreadsheet URL (for “open row” links in the admin panel)
SHEETS_SPREADSHEET_URL=
SHEETS_WEBHOOK_TOKEN=<random-32-chars>

# --- WhatsApp -----------------------------------------------------------------------------------
# simulator = no live number (admin → WhatsApp Simulator); meta = Meta WhatsApp Cloud API
WHATSAPP_PROVIDER=simulator
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=<random-32-chars>
WHATSAPP_APP_SECRET=<random-or-meta-app-secret>
WHATSAPP_GRAPH_VERSION=v21.0


# --- Live property data: Apify ----------------------------------------------------------------
# API token from https://console.apify.com/settings/integrations — backend only, never commit it.
APIFY_API_TOKEN=<your-apify-token>
APIFY_ENABLED=true
# Actor that scrapes MagicBricks (rent + buy + plots) for Indian cities
APIFY_ACTOR=thirdwatch~magicbricks-scraper
# The backend talks to Apify this often: collects finished scrapes, syncs MongoDB, maybe starts a scrape
APIFY_SYNC_INTERVAL_MIN=10
# Listings per scrape run (the actor charges ~$0.003 per listing)
APIFY_MAX_RESULTS=12
# Scrapes are paced so this app never spends more than this per Apify billing cycle
APIFY_MONTHLY_BUDGET_USD=4.5
APIFY_PRICE_PER_RESULT_USD=0.003
APIFY_CITIES=Mumbai,Pune,Bangalore,Hyderabad,Gurgaon,Chennai

# --- Customer accounts: Google sign-in (optional) -------------------------------------------
# OAuth client from Google Cloud Console → APIs & Services → Credentials (type: Web application).
# Authorised redirect URI to register there: http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
# Leave empty to use PUBLIC_SITE_URL + /api/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- Admin panel --------------------------------------------------------------------------------
ADMIN_EMAIL=admin@nestr.local
ADMIN_PASSWORD=<strong-password>
JWT_SECRET=<random-64-chars>
