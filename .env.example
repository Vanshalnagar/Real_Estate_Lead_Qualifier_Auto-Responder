# ---------------------------------------------------------------------------------------------
# Root .env — read by docker-compose (n8n) and n8n/import.sh. Copy to .env or run `npm run setup:env`.
# Never commit .env. Only this example file is tracked.
# ---------------------------------------------------------------------------------------------

# n8n encrypts stored credentials with this key. Generate once and never change it
# (changing it makes existing n8n credentials unreadable). 48+ random chars.
N8N_ENCRYPTION_KEY=<random-48-chars>

# n8n owner account (created by n8n/import.sh on first run; log in at http://localhost:5678)
N8N_OWNER_EMAIL=admin@nestr.local
N8N_OWNER_PASSWORD=<StrongPassword1>
N8N_OWNER_FIRST_NAME=NESTR
N8N_OWNER_LAST_NAME=Admin

# Public base URL n8n uses for its webhook URLs (set to your tunnel URL when exposing webhooks)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/

# How n8n (inside Docker) reaches the backend running on the host
BACKEND_INTERNAL_URL=http://host.docker.internal:4000

# Non-secret values the workflow reads via $env (secrets live in n8n credentials instead)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REPLY_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GEMINI_MODEL=gemini-3.5-flash-lite
PUBLIC_SITE_URL=http://localhost:5173
SHEETS_WEBAPP_URL=
WHATSAPP_PROVIDER=simulator
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
