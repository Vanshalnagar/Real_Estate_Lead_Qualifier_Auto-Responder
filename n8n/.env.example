# Render n8n service. Do not use SQLite on an ephemeral filesystem.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=<private-postgres-host>
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=<secret>
N8N_ENCRYPTION_KEY=<copy-existing-local-key-exactly>
N8N_HOST=<n8n-service>.onrender.com
N8N_PORT=5678
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_PROTOCOL=https
WEBHOOK_URL=https://<n8n-service>.onrender.com/
N8N_EDITOR_BASE_URL=https://<n8n-service>.onrender.com/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true
GENERIC_TIMEZONE=Asia/Kolkata
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
BACKEND_INTERNAL_URL=http://<private-api-host>:10000
PUBLIC_SITE_URL=https://<static-site>.onrender.com
INTERNAL_API_SECRET=<same-as-backend>
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REPLY_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GEMINI_MODEL=gemini-3.5-flash-lite
SHEETS_WEBAPP_URL=
SHEETS_WEBHOOK_TOKEN=
WHATSAPP_PROVIDER=simulator
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Set only for the explicit one-time operator import command.
N8N_IMPORT_PROJECT_ID=
NESTR_IMPORT_CONFIRM=no
